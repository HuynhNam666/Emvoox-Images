# ===== Docker Compose =====
POSTGRES_USER=emvoox
POSTGRES_PASSWORD=change-me          # BẮT BUỘC đổi
POSTGRES_DB=emvoox_images
API_PORT=8000                        # cổng API trên localhost; đổi nếu bị trùng (vd 8010)
WEB_PORT=8080                        # cổng giao diện web trên localhost
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
SDXL_CPU_OFFLOAD=false               # true = chậm hơn nhưng đỡ VRAM; cần ~8GB RAM trống
# MODEL_CACHE_HOST=D:/emvoox-data/models   # tùy chọn (nên đặt ở ổ nhiều dung lượng): dùng thư mục máy chủ chứa weights đã tải thay cho volume "models"
HF_TOKEN=                            # để trống nếu không cần; KHÔNG commit token thật

# ===== Chạy trực tiếp, không Docker (backend đọc file này) =====
# Dùng 127.0.0.1 thay vì localhost: trên Windows "localhost" có thể treo kết nối tới cổng Docker.
# DATABASE_URL=postgresql+psycopg://emvoox:change-me@127.0.0.1:5432/emvoox_images
# REDIS_URL=redis://127.0.0.1:6379/0
# MODEL_CACHE_DIR=D:/emvoox-data/models      # SDXL ~7GB + IP-Adapter ~3,3GB + LoRA; mặc định ./data/models
# DATASET_DIR=D:/emvoox-data/datasets        # dataset đã xuất + checkpoint train (~0,7GB/lần); mặc định ./data/datasets

# ===== Video (ComfyUI chạy riêng; xem docs/VIDEO_WORKFLOW.md) =====
# COMFYUI_URL=http://127.0.0.1:8188          # trong Docker: http://host.docker.internal:8188
# COMFYUI_TIMEOUT_S=1800
# VIDEO_COST_PER_GPU_SECOND=0                 # 0 = chi phí đo bằng giây GPU; đặt đơn giá nếu muốn quy ra tiền
# VIDEO_MAX_REPAIRS=2
