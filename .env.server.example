# ===== Mẫu cấu hình SERVER (sao chép thành .env). KHÔNG commit file .env =====
POSTGRES_USER=emvoox
POSTGRES_PASSWORD=change-me-to-a-long-random-string      # BẮT BUỘC đổi
POSTGRES_DB=emvoox_images

# --- Truy cập ---
API_TOKEN=change-me-too-a-long-random-token               # BẮT BUỘC khi ra Internet: đăng nhập giao diện bằng token này
COOKIE_SECURE=false                                       # true khi chạy sau HTTPS (Caddy/Nginx)
WEB_BIND=127.0.0.1                                        # 0.0.0.0 nếu mở cổng web trực tiếp (khuyến nghị: để Caddy làm HTTPS)
API_BIND=127.0.0.1
WEB_PORT=8080
# DOMAIN=studio.example.com                               # dùng với: docker compose --profile tls up -d

# --- Model ---
MODEL_GROUPS=core                                         # core = video+sdxl+klein+face (≈87 GB); thêm zimage,qwen khi cần (docs/SERVER_DEPLOY.md)
# MODEL_CACHE_HOST=/mnt/nvme/emvoox-models                # thư mục máy chủ chứa model (nên là ổ NVMe lớn) thay cho volume "models"
HF_TOKEN=

# --- Pháp lý / dữ liệu ---
COMMERCIAL_USE=false                                      # true: chặn train bằng dataset phi thương mại hoặc chưa rõ giấy phép
REQUIRE_LABEL=true                                        # bắt buộc nhãn AI hiển thị khi xuất bản
REQUIRE_C2PA=false                                        # true: chặn phát hành nếu chưa ký + xác minh C2PA (cần chứng thư bên dưới)
C2PA_CERT_PATH=                                           # đường dẫn TRONG container, vd /data/exports/c2pa/chain.pem
C2PA_KEY_PATH=
C2PA_TSA_URL=

# --- Chi phí (0 = chưa khai báo đơn giá; báo cáo chỉ hiện giờ GPU thay vì quy ra tiền) ---
GPU_COST_PER_HOUR=0                                       # USD/giờ GPU (thuê hoặc khấu hao)
STORAGE_COST_PER_GB_MONTH=0
QA_COST_PER_REVIEW=0
VIDEO_COST_PER_GPU_SECOND=0

# --- API ảnh bên ngoài (tùy chọn; thiếu khóa => Model Router tự loại model đó) ---
BFL_API_KEY=                                              # FLUX.2 Pro / Klein API / "FLUX 3 Image"
BFL_FLUX3_ENDPOINT=                                       # chỉ điền khi đã xác minh endpoint FLUX 3 Image
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image                 # đổi sang id Nano Banana 2.x khi đã xác minh
SEEDREAM_API_KEY=
SEEDREAM_MODEL=seedream-4-5-251128
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- ComfyUI (video) ---
# COMFY_ARGS=--lowvram                                    # thêm khi GPU < 24GB; --highvram cho GPU >= 48GB
