# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: inline "# ..." after a value can end up inside the value.

# Strong password; any characters are fine, quote it if it contains # or spaces.
POSTGRES_PASSWORD=<choose-a-strong-password>

# sdxl or mock (mock = CI only, images are stamped MOCK)
IMAGE_PROVIDER=sdxl
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# Leave empty, or pin a commit hash after verifying the checkpoint
SDXL_REVISION=
# Only needed if the model requires accepting a license on Hugging Face
HF_TOKEN=
# CPU offload for ~8 GB GPUs; set false on >=16 GB
LOW_VRAM_OFFLOAD=true

# Host ports
WEB_PORT=8080
API_PORT=8010
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
